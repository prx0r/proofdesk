# ProofDesk — Environment Configuration
# Copy this to .env and fill in your API keys.
# NEVER commit .env or .env.keys to version control.

# Nutrient DWS (evidence extraction)
NUTRIENT_API_KEY=

# Doctavian (document generation)
DOCTAVIAN_API_KEY=
DOCTAVIAN_BASE_URL=https://demo.api.doctavian.com
DOCTAVIAN_BEARER_TOKEN=
DOCTAVIAN_SUBSCRIPTION_KEY=

# Foxit PDF Services (merge, compress — reversible operations)
FOXIT_CLOUD_API_CLIENT_ID=
FOXIT_CLOUD_API_CLIENT_SECRET=

# Foxit eSign (irreversible signing — gated by SignatureGate)
FOXIT_ESIGN_CLIENT_ID=
FOXIT_ESIGN_CLIENT_SECRET=
